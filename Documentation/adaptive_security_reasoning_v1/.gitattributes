*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
# Preserve the original terminal-authored recovery record's CRLF bytes.
demo_shortcut_recovery.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Final verification logs retain their emitted bytes on every checkout.
final_*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
